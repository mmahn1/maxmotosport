# Google Maps API Configuration
# Copy this file to .env and replace with your actual API keys
# NEVER commit .env to Git!

# For local development
GOOGLE_MAPS_API_KEY_DEV=your_development_api_key_here

# For production (maxmotosport.eu)
GOOGLE_MAPS_API_KEY_PROD=your_production_api_key_here

# Current environment (dev or prod)
NODE_ENV=development
